icipates.","decision_es":"Pierde 40 puestos en la grilla de la próxima carrera","tipo":"grilla","proxima_carrera":true}],"mejoras":{"titulo":"Doc 9 - Car Presentation Submissions","url":"https://www.fia.com/system/files/decision-document/2026_singapore_grand_prix_-_car_presentation_submissions.pdf","publicado":"09.10.26 10:08","equipos":[{"equipo":"McLaren Mastercard F1 Team","mejoras":[{"componente":"Front Corner","motivo":"Para este circuito: refrigeración","detalle":"High Cooling Front Brake Duct To meet the high brake cooling demands of this and upcoming circuits, a new front brake duct aiming at increased brake cooling massflow has been designed."}],"leido":true},{"equipo":"Mercedes-AMG PETRONAS F1 Team","mejoras":[{"componente":"Front Wing","motivo":"Rendimiento: mejor flujo de aire","detalle":"Change in chord distribution between three wing elements; switch to two element SM Change in chordwise and spanwise loading, results in improved performance across the operating envelope, including improved front tyre wake control."},{"componente":"Front Wing Endplate","motivo":"Rendimiento: mejor flujo de aire","detalle":"Front wing endplate and footplate adjusted to accommodate the above. Diveplane camber adjusted."}],"leido":true},{"equipo":"Oracle Red Bull Racing","mejoras":[{"componente":"Front Wing","motivo":"Rendimiento: más carga en la zona","detalle":"Revised end plate and flap geometries A new wing design has been achieved by modifying a previous front wing assembly, which has been further optimised to offer more local load whilst maintaining the flow stability."},{"componente":"Rear Wheel Bodywork","motivo":"Fiabilidad","detalle":"Enlarged exit duct By modifying existing parts, a larger exit duct has been achieved for more cooling flow to cope with the anticipated brake energy of the Singapore circuit"}],"leido":true},{"equipo":"SCUDERIA FERRARI HP","mejoras":[],"leido":true},{"equipo":"Williams","mejoras":[],"leido":true},{"equipo":"Visa Cash App Racing Bulls","mejoras":[],"leido":true},{"equipo":"Aston Martin Aramco F1 Team","mejoras":[],"leido":true},{"equipo":"TGR HAAS F1 TEAM","mejoras":[],"leido":true},{"equipo":"BWT Alpine F1 Team","mejoras":[],"leido":true},{"equipo":"Audi Revolut F1 Team","mejoras":[],"leido":true},{"equipo":"Cadillac","mejoras":[],"leido":true}]}},"actualizado":"2026-10-15T11:45:28+00:00","fuentes":{"Jolpica":{"ok":true},"OpenF1":{"ok":true},"FIA":{"ok":true}}}