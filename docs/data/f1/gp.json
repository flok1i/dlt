:"https://www.fia.com/system/files/decision-document/2026_las_vegas_grand_prix_-_car_presentation_submissions.pdf","publicado":"19.11.26 23:00","equipos":[{"equipo":"McLaren Mastercard F1 Team","mejoras":[{"componente":"Floor Furniture","motivo":"Rendimiento: mejor flujo de aire","detalle":"New Board and Floor Edge A new floor board has been designed in conjunction with floor edge and diffuser, aiming at improved flow conditioning and aerodynamic load."},{"componente":"Floor Furniture","motivo":"Rendimiento: mejor flujo de aire","detalle":"Modified Rear Floor Furniture A small modification to the rear floor furniture, manipulating rear corner and diffuser flow with the aim of increasing aerodynamic efficiency."}],"leido":true},{"equipo":"Mercedes-AMG PETRONAS F1 Team","mejoras":[{"componente":"Rear Corner","motivo":"Rendimiento: más carga en la zona","detalle":"Rear corner winglets position and span Rear corner winglets position and span optimised around local load requirements, shedding local downforce and drag at a ratio appropriate for Vegas L/D. 4 Engine Cover Cooling Range Narrower rear exit A narrower rear exit allows more cooling range, appropriate for the lower cooling requirements of Vegas."}],"leido":true},{"equipo":"Oracle Red Bull Racing","mejoras":[{"componente":"Front Wing Endplate","motivo":"Rendimiento: más carga en la zona","detalle":"Re-positioned Front Wing Endplate Dive-plane In order to better protect the flow stability of the front wing endplate footplate as well as surfaces downstream, the dive-plane has been lowered and reduced in chord length."}],"leido":true},{"equipo":"Scuderia Ferrari HP","mejoras":[],"leido":false},{"equipo":"Williams","mejoras":[],"leido":true},{"equipo":"Visa Cash App Racing Bulls","mejoras":[{"componente":"Front Wing","motivo":"Para este circuito: balance aerodinámico","detalle":"Reduced chord & incidence flap A low-balance front wing flap, featuring chord and incidence changes, is available for this circuit to reduce the load generated by the front wing and extend the available balance range."}],"leido":true},{"equipo":"Aston Martin Aramco F1 Team","mejoras":[],"leido":true},{"equipo":"TGR HAAS F1 Team","mejoras":[{"componente":"Rear Wing","motivo":"Rendimiento: menos resistencia","detalle":"Revised rear wing arrangement associated with the Straight Mode mechanism The revised arrangement is intended to evaluate an alternative rear wing Straight Mode deployment, with associated minor changes to accommodate the different configuration."}],"leido":true},{"equipo":"Audi Revolut F1 Team","mejoras":[],"leido":false},{"equipo":"BWT Alpine F1 Team","mejoras":[],"leido":true},{"equipo":"Cadillac","mejoras":[],"leido":true}]}},"actualizado":"2026-11-22T18:15:00+00:00","fuentes":{"Jolpica":{"ok":true},"OpenF1":{"ok":true},"FIA":{"ok":true}}}